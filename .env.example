# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env && chmod 600 .env

# Internal PostgreSQL service credentials, generated by the operator once. They
# are never shown on the RGM sign-in screen; browser users sign in by email only.
# Generate each independently with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Non-owner database login used by app and worker.
RGM_RUNTIME_PASSWORD=

# The HMAC key behind upload capabilities. Required in production, because the
# built-in development secret is in this repository and would let anyone who can
# reach the upload endpoint forge one: openssl rand -hex 32
STORAGE_SECRET=

# Where the app is reachable. Sign-in and invite links are built from this, so it
# must be the address people actually use — not localhost.
PUBLIC_URL=http://192.168.168.92:3000

# The port the app is published on. 80 is usually taken.
APP_PORT=3000

# Translation. With no provider configured the app stores the stub's output — the
# original text prefixed with «<lang>» — so nothing is actually translated and the
# reader sees Vietnamese under an English or Chinese heading.
#   TRANSLATE_PROVIDER=openai             any /v1/chat/completions server
#   TRANSLATE_BASE_URL=http://host:8012   host part only; /v1/chat/completions is appended
#   TRANSLATE_MODEL=qwen3.6-35b-a3b-uncensored
#   TRANSLATE_API_KEY=sk-...
#   TRANSLATE_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
#     — for a local server whose model thinks first: thinking is what makes a
#       request run for minutes, and only the translation is wanted.
TRANSLATE_PROVIDER=
TRANSLATE_BASE_URL=
TRANSLATE_MODEL=
TRANSLATE_API_KEY=
TRANSLATE_EXTRA_BODY=
