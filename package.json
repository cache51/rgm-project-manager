{
  "name": "rgm-project-manager",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Developer ↔ tester communication hub: multi-project bug tracking with Vietnamese/Chinese/English translation and one-command AI-agent handoff",
  "bin": {
    "rgm": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "bootstrap": "node src/bootstrap.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:pg": "RGM_TEST_DRIVER=pg node --test --test-concurrency=1 test/*.test.js",
    "test:realpg": "node --test --test-concurrency=1 test/*.test.js",
    "test:all": "npm test && npm run test:pg",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
